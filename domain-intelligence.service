[Unit]
Description=Domain Intelligence API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/domain_collector
Environment="PATH=/home/ubuntu/domain_collector/venv/bin"
ExecStart=/home/ubuntu/domain_collector/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
